<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite parallel="tests" name="Suite">


	<listeners>
		<listener class-name="TestPackage.listen"></listener>
	</listeners>


	<test thread-count="5" name="login">
		<classes>
			<class name="TestPackage.login" />
		</classes>

	</test> <!-- Test -->
	
	<test thread-count="5" name="greenkartTest">
		<parameter name="url"	value="https://rahulshettyacademy.com/seleniumPractise/#/"></parameter>
		<parameter name="promo" value="discount50%" ></parameter>
		<parameter name="country" value="Japan" ></parameter>
		
		<classes>
			<class name="TestPackage.greenkartTest" />
		</classes>

	</test> <!-- Test -->
	


</suite> <!-- Suite -->
